		if file.get_buffer(5) == "3.925".to_ascii_buffer():
			roth_exe_version = "3.925"
		file.seek(0x6d069)
		if file.get_buffer(5) == "3.983".to_ascii_buffer():
			roth_exe_version = "3.983"
		file.close()
		return roth_exe_version
